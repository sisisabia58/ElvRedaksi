DATABASE_URL=postgres://redaksi:redaksi@127.0.0.1:5432/redaksi
# Required. Must not be a value from the repo.
CRON_SECRET=
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_USD_PER_MTOK=0.15
OPENAI_OUTPUT_USD_PER_MTOK=0.60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Unset uses the code default of 10 requests/minute, under the
# free-tier minute window for gemini-3.5-flash-lite. A per-day 429 pauses
# every Gemini job until Google's retryDelay, whatever GEMINI_MAX_RPM is.
# GEMINI_MAX_RPM=10
GEMINI_INPUT_USD_PER_MTOK=0.30
GEMINI_OUTPUT_USD_PER_MTOK=2.50
META_PROVIDER=fake
PUBLIC_BASE_URL=http://127.0.0.1:43123
# Optional. Encrypts the Instagram access token at rest. If empty, CRON_SECRET is used.
# If both are empty, the token is stored in plaintext and a warning is logged.
TOKEN_ENCRYPTION_KEY=
CONTACT_WA=
SEED_DEMO=
